import os
import shutil
from pathlib import Path

from dotenv import load_dotenv
from fastapi import Depends, FastAPI, File, Form, HTTPException, UploadFile
from fastapi.middleware.cors import CORSMiddleware

from ATS_score import calculate_ats_score
from auth import get_current_user
from db.crud import get_single_analysis, get_user_analyses, save_analysis
from job_title import get_job_title_score
from keywords import get_jd_keywords, get_keywords
from texts import get_texts

load_dotenv()

app = FastAPI(title="ResumePilot API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

MEDIA_DIR = Path(__file__).parent / "media"
MEDIA_DIR.mkdir(exist_ok=True)


@app.get("/")
def root():
    return {"message": "The app is running"}


@app.post("/analyze")
async def analyze_resume(
    resume: UploadFile = File(...),
    job_description: str = Form(...),
    job_title: str = Form(...),
    user_id: str = Depends(get_current_user),
):
    temp_path = MEDIA_DIR / resume.filename

    try:
        with temp_path.open("wb") as buffer:
            shutil.copyfileobj(resume.file, buffer)

        extracted_text, github_username = get_texts(str(temp_path))
    finally:
        if temp_path.exists():
            temp_path.unlink()

    if not extracted_text:
        return {"Error": "Could not extract text from PDF. Try another file."}

    word_count = len(extracted_text.split())
    if 400 <= word_count <= 800:
        wc_msg = "Word count is within the recommended range of 400-800 words - ideal for a professional resume."
    elif word_count < 400:
        wc_msg = "Your resume is too brief. Add more detail to reach the recommended 400-800 word range."
    else:
        wc_msg = "Your resume exceeds the recommended limit. Trim it down to 800 words or fewer for maximum impact."

    resume_keywords = get_keywords(extracted_text)
    jd_keywords = get_jd_keywords(job_description)

    if resume_keywords is None or jd_keywords is None:
        return {"Error": "Keyword extraction failed. Try again later."}

    job_title_score = get_job_title_score(resume_keywords, job_title)
    if job_title_score == 100:
        jt_msg = f"Your resume aligns with the target role of {job_title}."
    else:
        jt_msg = f"Your resume does not appear to target the {job_title} role. Consider tailoring your resume for this position."

    raw_score = await calculate_ats_score(
        resume_keywords,
        jd_keywords,
        job_title_score,
        github_username,
    )

    if not raw_score:
        return {"Error": "Could not generate ATS score. Try again later."}

    result = normalize_result(raw_score, wc_msg, jt_msg)
    analysis_id = save_analysis(result, job_title, user_id)
    result["analysis_id"] = analysis_id
    result["history_saved"] = bool(analysis_id)
    return result


@app.get("/history")
async def get_history(user_id: str = Depends(get_current_user)):
    analyses = get_user_analyses(user_id)
    return {"analyses": analyses}


@app.get("/history/{analysis_id}")
async def get_scorecard(
    analysis_id: str,
    user_id: str = Depends(get_current_user),
):
    scorecard = get_single_analysis(analysis_id, user_id)
    if not scorecard:
        raise HTTPException(status_code=404, detail="Scorecard not found")
    return scorecard


def normalize_result(raw: dict, word_count_feedback: str, job_title_match: str) -> dict:
    return {
        "ats_score": raw.get("ats_score"),
        "word_count_feedback": word_count_feedback,
        "job_title_match": job_title_match,
        "github_status": raw.get("github") or raw.get("github_status"),
        "feedback": raw.get("feedback") or raw.get("overall_feedback"),
        "suggestions": raw.get("suggestions", []),
        "weak_sections": raw.get("weak_sections", []),
        "matched_hard_skills": raw.get("matched_hard_skills") or raw.get("hard_skills_match", []),
        "missing_hard_skills": raw.get("missing_hard_skills") or raw.get("hard_skills_missing", []),
        "matched_soft_skills": raw.get("matched_soft_skills") or raw.get("soft_skills_match", []),
        "missing_soft_skills": raw.get("missing_soft_skills") or raw.get("soft_skills_missing", []),
        "section_scores": raw.get("section_scores", {}),
    }

